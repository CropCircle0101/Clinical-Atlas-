# Copy to .env.local. Demo data is fictional and never mixes with live records.
DEMO_MODE=true
# Set DEMO_MODE=false and connect PostgreSQL with PostGIS for live mode.
DATABASE_URL=postgresql://clinicatlas:clinicatlas@localhost:5432/clinicatlas
# Remote databases should use TLS with a trusted CA. Never disable certificate checks.
DATABASE_SSL=false
# AI is opt-in per search, server-side only. No query history is stored by this app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generate at least 32 random characters. Admin login uses a short-lived signed cookie.
ADMIN_SECRET=
# Use your deployment origin for mutation origin checks.
APP_ORIGIN=http://127.0.0.1:3000
# Stadia Maps: localhost development is allowed. Register your production domain
# and choose an appropriate subscription before deployment. No secret is needed in JS.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json
# Optional: server-side place lookup beyond cities already in the directory.
STADIA_API_KEY=
# Enable only behind a proxy that overwrites X-Forwarded-For. Otherwise limits
# are intentionally shared per process. Use distributed rate limits for scale.
TRUST_PROXY=false
